    puts(str.upper("hi"))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "HI")
end

rats "call-site: Integer literal to float param is allowed (numeric coercion)"
  source = <<~RUGO
    def f(a : Float) : Float
      return a + 1.0
    end
    puts(f(2))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_contains(result["output"], "3")
end

rats "call-site: Float literal to int param is rejected (lossy truncation)"

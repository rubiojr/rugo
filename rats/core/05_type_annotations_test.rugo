# =====================================================================
# Section 8b — Numeric coercion is asymmetric: widening allowed,
# narrowing (Float -> Integer) rejected because it would silently
# truncate.
# =====================================================================

rats "call-site: negative Float literal to int param is rejected (lossy)"
  source = <<~RUGO
    def f(a : Integer) : Integer
      return a
    end
    puts(f(-1.5))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot pass Float literal as argument 1 to 'f' (parameter 'a' declared as Integer)")
end

rats "call-site: whole-number Float literal to int param is rejected (lossy)"
  source = <<~RUGO
    def f(a : Integer) : Integer
      return a
    end
    puts(f(2.0))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot pass Float literal as argument 1 to 'f' (parameter 'a' declared as Integer)")
end

rats "call-site: Float variable to int param is rejected (lossy)"
  source = <<~RUGO
    def f(a : Integer) : Integer
      return a
    end
    x = 1.5
    puts(f(x))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass Float value as argument 1 to 'f' (parameter 'a' declared as Integer)")
end

rats "call-site: Float-producing expression to int param is rejected (lossy)"
  source = <<~RUGO
    def f(a : Integer) : Integer
      return a
    end
    puts(f(1.5 + 2))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass Float")
  test.assert_contains(combined, "declared as Integer")
end

rats "call-site: Bool literal to float param is rejected (would panic at runtime)"
  source = <<~RUGO
    def f(a : Float) : Float
      return a
    end
    puts(f(true))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot pass Bool literal as argument 1 to 'f' (parameter 'a' declared as Float)")
end

rats "call-site: Integer literal to float param remains allowed (widening)"
  source = <<~RUGO
    def f(a : Float) : Float
      return a + 1.0
    end
    puts(f(2))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_contains(result["output"], "3")
end

rats "call-site: Bool literal to int param remains allowed (0/1 semantics)"
  source = <<~RUGO
    def f(a : Integer) : Integer
      return a
    end
    puts(f(true))
    puts(f(false))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "1")
  test.assert_contains(combined, "0")
end

rats "return: Float-producing expression from int-annotated function is rejected"
  source = <<~RUGO
    def f() : Integer
      return 1.5 + 2
    end
    puts(f())
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot return Float value from function declared returning Integer")
end

rats "return: Integer return from Float-annotated function remains allowed (widening)"
  source = <<~RUGO
    def f() : Float
      return 42
    end
    puts(f())
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_contains(result["output"], "42")
end

rats "default literal: float param accepts integer default (widening)"
  source = <<~RUGO
    def f(x : Float = 3) : Float
      return x + 0.5
    end
    puts(f())
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_contains(result["output"], "3.5")
end

rats "default literal: float param rejects bool default (would panic at runtime)"
  source = <<~RUGO
    def f(x : Float = true) : Float
      return x
    end
    puts(f())
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot use Bool literal as default for parameter 'x' declared as Float")
end

rats "call-site: literal-arg mismatch inside fn lambda body is caught"
  source = <<~RUGO
    def square(n : Integer) : Integer
      return n * n
    end
    f = fn()
      return square("oops")
    end
    puts(f())
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass String literal as argument 1 to 'square'")
end

rats "call-site: literal-arg mismatch in recursive self-call is caught"
  source = <<~RUGO
    def f(n : Integer) : Integer
      if n <= 0
        return 0
      end
      return f("oops")
    end
    puts(f(3))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass String literal as argument 1 to 'f'")
end

rats "call-site: literal-arg mismatch inside if condition is caught"
  source = <<~RUGO
    def is_pos(n : Integer) : Bool
      return n > 0
    end
    if is_pos("oops")
      puts("yes")
    end
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass String literal as argument 1 to 'is_pos'")
end

rats "call-site: literal-arg mismatch inside spawn body is caught"
  source = <<~RUGO
    def square(n : Integer) : Integer
      return n * n
    end
    task = spawn
      square("nope")
    end
    puts(task.value)
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass String literal as argument 1 to 'square'")
end

rats "call-site: literal-arg mismatch inside try expression is caught"
  source = <<~RUGO
    def f(n : Integer) : Integer
      return n * 2
    end
    result = try f("oops") or 99
    puts(result)
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass String literal as argument 1 to 'f'")
end

rats "call-site: pipe sugar with wrong literal-type is caught"
  source = <<~RUGO
    def square(n : Integer) : Integer
      return n * n
    end
    puts(square("oops"))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass String literal as argument 1 to 'square'")
end

rats "call-site: unannotated function is NOT flagged"
  source = <<~RUGO
    def f(a)
      return a
    end
    puts(f("anything"))
    puts(f(42))
    puts(f([1, 2]))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
end

rats "call-site: function with default-arg + annotation still validates literals"
  source = <<~RUGO
    def add(a : Integer = 1, b : Integer = 2) : Integer
      return a + b
    end
    puts(add("oops", 10))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass String literal as argument 1 to 'add'")
end

rats "call-site: function with default-arg + annotation accepts valid args"
  source = <<~RUGO
    def add(a : Integer = 1, b : Integer = 2) : Integer
      return a + b
    end
    puts(add(5, 10))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "15")
end

rats "call-site: --no-infer disables the call-site check"
  tmp = test.tmpdir()
  src_path = tmp + "/no_infer_t2.rugo"
  test.write_file(src_path, "def f(a : Integer) : Integer\n  return a + 1\nend\nputs(f(\"oops\"))\n")
  result = test.run("rugo run --no-infer " + src_path)
  # With --no-infer the call-site check is skipped so we never see the
  # compile-time "cannot pass" message (program may succeed or fail at
  # runtime depending on the operation, but the compile error is gone).
  test.assert_true(!str.contains(result["output"], "cannot pass String literal"))
end

rats "call-site: Bool literal to int param is allowed (numeric mutual)"
  source = <<~RUGO
    def f(a : Integer) : Integer
      return a
    end
    puts(f(true))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
end

rats "call-site: Integer literal to bool param is flagged (strict)"
  source = <<~RUGO
    def f(a : Bool) : Bool
      return a
    end
    puts(f(0))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot pass Integer literal as argument 1 to 'f' (parameter 'a' declared as Bool)")
end

rats "call-site: String literal to bool param is flagged (strict)"
  source = <<~RUGO
    def f(a : Bool) : Bool
      return a
    end
    puts(f("hi"))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot pass String literal as argument 1 to 'f' (parameter 'a' declared as Bool)")
end

rats "call-site: Array literal to bool param is flagged (strict)"
  source = <<~RUGO
    def f(a : Bool) : Bool
      return a
    end
    puts(f([1, 2]))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot pass Array literal as argument 1 to 'f' (parameter 'a' declared as Bool)")
end

# =====================================================================
# Section: Variable type annotations (`x : T = expr`)
# =====================================================================

rats "var annot: typed binding compiles and runs"
  source = <<~RUGO
    x : Integer = 42
    puts(x)
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "42")
end

rats "var annot: each builtin type name is accepted"
  source = <<~RUGO
    a : Integer = 1
    b : Float = 1.5
    c : String = "hi"
    d : Bool = true
    e : Array = [1, 2]
    f : Hash = {1 => 2}
    g : Nil = nil
    h : Any = 42
    puts(a)
    puts(b)
    puts(c)
    puts(d)
    puts(e)
    puts(g)
    puts(h)
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
end

rats "var annot: init type mismatch errors"
  source = <<~RUGO
    x : Integer = "hello"
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot assign String value to")
end

rats "var annot: reassign with incompatible type errors"
  source = <<~RUGO
    x : Integer = 0
    x = "hello"
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot assign String value to")
end

rats "var annot: any permits any reassignment"
  source = <<~RUGO
    x : Any = 0
    x = "hello"
    x = [1, 2]
    puts(x)
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "[1, 2]")
end

rats "var annot: Integer rejects lambda initializer"
  source = <<~RUGO
    fnvar : Integer = fn(x) x end
    puts(fnvar)
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot assign Lambda value to variable 'fnvar' declared as Integer")
end

rats "var annot: String rejects lambda initializer"
  source = <<~RUGO
    fnvar : String = fn() "hi" end
    puts(fnvar)
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot assign Lambda value to variable 'fnvar' declared as String")
end

rats "var annot: Bool rejects lambda initializer"
  source = <<~RUGO
    fnvar : Bool = fn() true end
    puts(fnvar)
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot assign Lambda value to variable 'fnvar' declared as Bool")
end

rats "var annot: Array rejects lambda initializer"
  source = <<~RUGO
    fnvar : Array = fn(x) x end
    puts(fnvar)
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot assign Lambda value to variable 'fnvar' declared as Array")
end

rats "var annot: Hash rejects lambda initializer"
  source = <<~RUGO
    fnvar : Hash = fn(x) x end
    puts(fnvar)
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot assign Lambda value to variable 'fnvar' declared as Hash")
end

rats "var annot: Nil rejects lambda initializer"
  source = <<~RUGO
    fnvar : Nil = fn() nil end
    puts(fnvar)
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot assign Lambda value to variable 'fnvar' declared as Nil")
end

rats "var annot: Any accepts lambda initializer"
  source = <<~RUGO
    fnvar : Any = fn(x) x * 2 end
    puts(fnvar(5))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "10")
end

rats "var annot: Integer rejects lambda reassignment"
  source = <<~RUGO
    count : Integer = 0
    count = fn(x) x end
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot assign Lambda value to variable 'count' declared as Integer")
end

rats "param annot: Integer rejects lambda reassignment inside body"
  source = <<~RUGO
    def f(a : Integer)
      a = fn(x) x end
    end
    f(1)
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot assign Lambda value to parameter 'a' declared as Integer")
end

rats "var annot: unknown type name errors with valid type hint"
  source = <<~RUGO
    x : foobar = 0
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "unknown type")
  test.assert_contains(result["output"], "foobar")
end

rats "var annot: re-annotation in same scope errors"
  source = <<~RUGO
    x : Integer = 0
    x : Integer = 1
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "re-annotation")
end

rats "var annot: unannotated path still permits mixed reassignment"
  source = <<~RUGO
    x = 1
    x = "hello"
    puts(x)
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "hello")
end

rats "var annot: inside function body"
  source = <<~RUGO
    def f()
      x : Integer = 10
      return x * 2
    end
    puts(f())
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "20")
end

rats "var annot: function-body reassignment violation"
  source = <<~RUGO
    def f()
      x : Integer = 10
      x = "oops"
      return x
    end
    puts(f())
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot assign String value to")
end

rats "var annot: independent scopes in different functions"
  source = <<~RUGO
    def a()
      x : Integer = 1
      return x
    end
    def b()
      x : String = "hi"
      return x
    end
    puts(a())
    puts(b())
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
end

rats "var annot: numeric promotion not permitted at assignment site"
  source = <<~RUGO
    x : Float = 1.0
    x = 42
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot assign Integer value to")
end

# =====================================================================
# Section: Tier 3 flow-sensitive checks (callsite + return)
# =====================================================================

rats "tier3: callsite flow flags identifier arg with concrete string type"
  source = <<~RUGO
    def f(x : Integer)
      return x
    end
    y = "hello"
    f(y)
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot pass String value as argument 1 to 'f'")
end

rats "tier3: callsite flow allows arg narrowed back to compatible type"
  source = <<~RUGO
    def f(x : Integer)
      return x + 1
    end
    y = "h"
    y = 42
    puts(f(y))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "43")
end

rats "tier3: callsite flow flags arg from if/else union"
  source = <<~RUGO
    def f(x : Integer)
      return x
    end
    if true
      y = 1
    else
      y = "h"
    end
    f(y)
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot pass")
end

rats "tier3: callsite flow passes dynamic argument silently"
  source = <<~RUGO
    def f(x : Integer)
      return x
    end
    h = {1 => 100}
    x = h[1]
    puts(f(x))
  RUGO
  result = eval.run(source)
  # Dynamic types (here from hash indexing) cannot be proven incompatible
  # at compile time, so the call must compile. Runtime coercion handles
  # the actual conversion.
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "100")
end

rats "tier3: return flow flags ident return with concrete mismatch"
  source = <<~RUGO
    def f() : Integer
      x = "hello"
      return x
    end
    f()
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot return String value from function declared returning Integer")
end

rats "tier3: return flow allows ident return narrowed back to compat"
  source = <<~RUGO
    def f() : Integer
      x = "h"
      x = 42
      return x
    end
    puts(f())
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "42")
end

rats "tier3: implicit return flow flags ident with concrete mismatch"
  source = <<~RUGO
    def f() : Integer
      x = "hello"
      x
    end
    f()
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot implicitly return String value")
end

rats "tier3: return flow flags ident from union via if-no-else"
  source = <<~RUGO
    def f() : Integer
      x = 1
      if true
        x = "h"
      end
      return x
    end
    f()
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot return")
end

rats "tier3: combined callsite + return flow with narrowed ident"
  source = <<~RUGO
    def f(x : Integer) : Integer
      return x * 2
    end
    y = "h"
    y = 21
    puts(f(y))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "42")
end

rats "tier3: after for-loop maybe-not-executed, ident arg is union and flagged"
  source = <<~RUGO
    def f(x : Integer)
      return x
    end
    y = 1
    for item in [1, 2, 3]
      y = "h"
    end
    f(y)
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot pass")
end

rats "tier3: after while-loop maybe-not-executed, ident arg is union and flagged"
  source = <<~RUGO
    def f(x : Integer)
      return x
    end
    y = 1
    while false
      y = "h"
    end
    f(y)
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot pass")
end

rats "tier3: after case-stmt no-else, ident arg is union and flagged"
  source = <<~RUGO
    def f(x : Integer)
      return x
    end
    s = "a"
    y = 1
    case s
    of "a"
      y = "h"
    end
    f(y)
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot pass")
end

# =====================================================================
# Section: Tier 4 fn lambda call-site checks
# =====================================================================
# When a variable is assigned an annotated `fn(...)` lambda and later
# called by name, the compiler validates the arguments against the
# lambda's parameter annotations the same way it does for `def`. The
# binding is tracked flow-sensitively: aliasing propagates the signature,
# reassignment to a different annotated lambda updates it, reassignment
# to a non-fn value clears it, and merge ambiguity drops it silently
# (matching the existing "unresolved is silent" gradual-typing rule).

rats "tier4: lambda direct binding rejects literal type mismatch"
  source = <<~RUGO
    square = fn(n : Integer) : Integer
      return n * n
    end
    puts(square("oops"))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass String literal as argument 1 to 'square'")
  test.assert_contains(combined, "parameter 'n' declared as Integer")
end

rats "tier4: lambda direct binding accepts matching literal"
  source = <<~RUGO
    square = fn(n : Integer) : Integer
      return n * n
    end
    puts(square(7))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "49")
end

rats "tier4: lambda binding flagged for second-arg mismatch"
  source = <<~RUGO
    add = fn(a : Integer, b : Integer) : Integer
      return a + b
    end
    puts(add(1, "oops"))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass String literal as argument 2 to 'add'")
  test.assert_contains(combined, "parameter 'b' declared as Integer")
end

rats "tier4: aliasing propagates the lambda signature"
  source = <<~RUGO
    square = fn(n : Integer) : Integer
      return n * n
    end
    g = square
    puts(g("oops"))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass String literal as argument 1 to 'g'")
  test.assert_contains(combined, "parameter 'n' declared as Integer")
end

rats "tier4: aliased lambda accepts matching literal"
  source = <<~RUGO
    square = fn(n : Integer) : Integer
      return n * n
    end
    g = square
    puts(g(6))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "36")
end

rats "tier4: reassignment to a different annotated lambda uses new sig"
  source = <<~RUGO
    f = fn(n : Integer) : Integer
      return n
    end
    f = fn(arr : Array) : Array
      return arr
    end
    puts(f(42))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass Integer literal as argument 1 to 'f'")
  test.assert_contains(combined, "parameter 'arr' declared as Array")
end

rats "tier4: reassignment to non-fn value clears signature (silent)"
  source = <<~RUGO
    f = fn(n : Integer) : Integer
      return n
    end
    f = "not a fn anymore"
    puts(len(f))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "16")
end

rats "tier4: variable arg flow-sensitive narrowing through reassignment"
  source = <<~RUGO
    square = fn(n : Integer) : Integer
      return n * n
    end
    y = "h"
    y = 5
    puts(square(y))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "25")
end

rats "tier4: variable arg with concrete wrong type flagged"
  source = <<~RUGO
    square = fn(n : Integer) : Integer
      return n * n
    end
    y = "hello"
    square(y)
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass String value as argument 1 to 'square'")
end

rats "tier4: branch divergence drops signature (silent at call)"
  source = <<~RUGO
    if true
      f = fn(n : Integer) : Integer
        return n
      end
    else
      f = fn(s : String) : String
        return s
      end
    end
    # f's signature is ambiguous after the merge; the call must be
    # silent (no compile error) and fall back to dynamic dispatch.
    puts(f(42))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "42")
end

rats "tier4: lambda passed as arg to higher-order func is silent"
  source = <<~RUGO
    def apply(f, x)
      return f(x)
    end
    inc = fn(n : Integer) : Integer
      return n + 1
    end
    # apply's parameter has no annotation, so passing inc here cannot
    # be checked. Calls THROUGH apply are unchecked.
    puts(apply(inc, 41))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "42")
end

rats "tier4: lambda inside an array is silent at call site"
  source = <<~RUGO
    arr = [fn(n : Integer) : Integer
      return n + 1
    end]
    # arr[0]("oops") is an indexed call; the callee is not a bare
    # IdentExpr so the Tier 4 check does not fire. Runtime handles it.
    puts(arr[0](41))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "42")
end

rats "tier4: lambda inside function body — local scope check"
  source = <<~RUGO
    def outer()
      g = fn(n : Integer) : Integer
        return n * 2
      end
      return g("oops")
    end
    outer()
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass String literal as argument 1 to 'g'")
end

rats "tier4: lambda with no annotated params — no check fires"
  source = <<~RUGO
    f = fn(n)
      return n
    end
    puts(f("anything"))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "anything")
end

rats "tier4: mixed annotated/unannotated lambda params — only annotated checked"
  source = <<~RUGO
    f = fn(a, b : Integer)
      return b
    end
    puts(f("anything", "oops"))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass String literal as argument 2 to 'f'")
  test.assert_contains(combined, "parameter 'b' declared as Integer")
end

rats "tier4: lambda with return-only annotation does NOT trigger arg checks"
  source = <<~RUGO
    f = fn(n) : Integer
      return 0
    end
    puts(f("anything"))
  RUGO
  result = eval.run(source)
  # n has no annotation, so passing a string is silent at the call site.
  test.assert_eq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_eq(str.contains(combined, "cannot pass"), false)
end

rats "tier4: --no-infer disables lambda call-site checks"
  source = <<~RUGO
    square = fn(n : Integer) : Integer
      return n
    end
    puts(square("oops"))
  RUGO
  # Write the snippet to a tempfile and run rugo with --no-infer
  # to verify the lambda check is gated on inference like the def
  # check is.
  dir = test.tmpdir()
  path = dir + "/snippet.rugo"
  test.write_file(path, source)
  result = test.run("rugo run --no-infer " + path)
  combined = result["output"] + result["output"]
  test.assert_eq(str.contains(combined, "cannot pass String literal"), false)
end

rats "tier4: strict rule — int variable passed to string-annotated lambda param is flagged"
  source = <<~RUGO
    f = fn(name : String)
      puts("hi " + name)
    end
    x = 42
    f(x)
  RUGO
  result = eval.run(source)
  # String annotation no longer accepts arbitrary types at the call site.
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot pass Integer value as argument 1 to 'f' (parameter 'name' declared as String)")
end

rats "tier4: permissive rule — int passed where float-annotated lambda param"
  source = <<~RUGO
    f = fn(x : Float) : Float
      return x + 1.0
    end
    puts(f(2))
  RUGO
  result = eval.run(source)
  # Numeric family is mutually compatible.
  test.assert_eq(result["status"], 0)
  test.assert_contains(result["output"], "3")
end

rats "tier4: lambda call-site check skips method/dot calls"
  source = <<~RUGO
    f = fn(n : Integer) : Integer
      return n
    end
    h = {"go" => f}
    # h["go"](...) is a method/index call, not a bare ident — skipped.
    puts(h["go"]("oops"))
  RUGO
  result = eval.run(source)
  # Should compile (no compile error from Tier 4); runtime may fail.
  combined = result["output"] + result["output"]
  test.assert_eq(str.contains(combined, "cannot pass String literal"), false)
end

rats "tier4: lambda param shadows outer fn binding (no false positive)"
  # Regression: an inner fn lambda whose own param shadows an outer
  # variable that happens to hold an annotated lambda. The inner call
  # MUST resolve to the param, not fall through to the outer binding.
  source = <<~RUGO
    f = fn(n : Integer) : Integer
      return n
    end
    g = fn(f)
      return f("ok")
    end
    puts(g(42))
  RUGO
  result = eval.run(source)
  # The compile-time Tier 4 check must NOT fire on `f("ok")` inside g.
  combined = result["output"] + result["output"]
  test.assert_eq(str.contains(combined, "cannot pass String literal"), false)
end

rats "tier4: function-body local shadows top-level fn binding"
  # Inside a def, a local rebinding to a non-fn value must not be
  # confused with the outer fn variable. (def bodies use a fresh
  # inference scope so this is naturally silent, but keep a guard.)
  source = <<~RUGO
    f = fn(n : Integer) : Integer
      return n
    end
    def use_local()
      f = "not a fn"
      return f
    end
    puts(use_local())
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_contains(result["output"], "not a fn")
end

rats "tier4: inner if/else cannot leak fn binding to outer scope"
  # Both arms drop the binding (or never establish one); after the if,
  # the outer call must resolve against the original fn binding.
  source = <<~RUGO
    f = fn(n : Integer) : Integer
      return n
    end
    if 1 == 1
      f = "x"
    else
      f = 99
    end
    # Both arms cleared the binding, so calling f after the if is
    # silent at the Tier 4 layer (runtime will fail).
    nil
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
end

rats "tier4: aliasing chain of three propagates signature"
  source = <<~RUGO
    f = fn(n : Integer) : Integer
      return n
    end
    g = f
    h = g
    puts(h("oops"))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass String literal as argument 1 to 'h'")
  test.assert_contains(combined, "parameter 'n' declared as Integer")
end

# =====================================================================
# Section — Legacy v0.29 lowercase annotation names rejected with hint
#
# v0.29.0/v0.29.1 shipped with lowercase annotation names (`int`,
# `float`, `string`, `bool`, `array`, `hash`, `nil`, `any`). Those
# are no longer accepted; the canonical capitalised names (`Integer`,
# `Float`, ...) mirror what `type_of()` returns. The compiler emits a
# targeted "did you mean Foo?" hint for each legacy name so old code
# is easy to update.
# =====================================================================

rats "legacy lowercase 'int' rejected with hint pointing to Integer"
  source = <<~RUGO
    def f(x : int)
      return x
    end
    puts(f(1))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "unknown type")
  test.assert_contains(combined, "did you mean")
  test.assert_contains(combined, "Integer")
end

rats "legacy lowercase 'float' rejected with hint pointing to Float"
  source = <<~RUGO
    def f(x : float)
      return x
    end
    puts(f(1.0))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "did you mean")
  test.assert_contains(combined, "Float")
end

rats "legacy lowercase 'string' rejected with hint pointing to String"
  source = <<~RUGO
    def f(x : string)
      return x
    end
    puts(f("hi"))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "did you mean")
  test.assert_contains(combined, "String")
end

rats "legacy lowercase 'bool' rejected with hint pointing to Bool"
  source = <<~RUGO
    def f(x : bool)
      return x
    end
    puts(f(true))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "did you mean")
  test.assert_contains(combined, "Bool")
end

rats "legacy lowercase 'array' rejected with hint pointing to Array"
  source = <<~RUGO
    def f(x : array)
      return x
    end
    puts(f([1, 2]))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "did you mean")
  test.assert_contains(combined, "Array")
end

rats "legacy lowercase 'hash' rejected with hint pointing to Hash"
  source = <<~RUGO
    def f(x : hash)
      return x
    end
    puts(f({1 => 2}))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "did you mean")
  test.assert_contains(combined, "Hash")
end

rats "legacy lowercase 'any' rejected with hint pointing to Any"
  source = <<~RUGO
    def f(x : any)
      return x
    end
    puts(f(1))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "did you mean")
  test.assert_contains(combined, "Any")
end

rats "legacy lowercase on return type rejected with hint"
  source = <<~RUGO
    def f(x : Integer) : int
      return x
    end
    puts(f(42))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "unknown type")
  test.assert_contains(combined, "Integer")
end

rats "legacy lowercase on fn lambda param rejected with hint"
  source = <<~RUGO
    f = fn(x : int) : Integer
      return x
    end
    puts(f(1))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "did you mean")
  test.assert_contains(combined, "Integer")
end

rats "legacy lowercase on var annotation rejected with hint"
  source = <<~RUGO
    x : int = 42
    puts(x)
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "unknown type")
  test.assert_contains(combined, "did you mean")
  test.assert_contains(combined, "Integer")
end

rats "type_of returns capitalised names that match annotations"
  source = <<~RUGO
    puts(type_of(1))
    puts(type_of(1.5))
    puts(type_of("hi"))
    puts(type_of(true))
    puts(type_of([1]))
    puts(type_of({1 => 2}))
    puts(type_of(nil))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  combined = result["output"]
  test.assert_contains(combined, "Integer")
  test.assert_contains(combined, "Float")
  test.assert_contains(combined, "String")
  test.assert_contains(combined, "Bool")
  test.assert_contains(combined, "Array")
  test.assert_contains(combined, "Hash")
  test.assert_contains(combined, "Nil")
end

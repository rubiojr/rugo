  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot return String value from function declared returning Integer")
end

rats "mismatch: only the conflicting return errors, valid returns are fine"
  source = <<~RUGO

# RATS: sqlite module — tests the Rugo glue, not SQLite itself.
# Validates type normalization, nil semantics, connection handles,
# error handling integration, and parameterized query binding.
use "test"
use "sqlite"

# Own each connection through assertions and SQL failures. Skip before entering
# this scope: try/or rethrows messages, not the runner's special skip signal.
def with_database(path, action)
  conn = sqlite.open(path)
  result = try action(conn) or err
    try sqlite.close(conn)
    raise err
  end
  sqlite.close(conn)
  return result
end

def with_table(action)
  return with_database(":memory:", fn(conn)
    sqlite.exec(conn, "CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT, score REAL, data BLOB, flag INTEGER)")
    action(conn)
  end)
end

# Only an operation expected to fail belongs in action, not assertions or skips.
def database_error(action)
  message = nil
  try action() or err
    message = err
  end
  if message == nil
    test.fail "expected a database error, but the operation succeeded"
  end
  return message
end

rats "open returns a connection handle"
  with_database(":memory:", fn(conn)
    test.assert_neq conn, nil
  end)
end

rats "open file-based database"
  path = "#{test.tmpdir()}/test.db"
  with_database(path, fn(conn)
    sqlite.exec(conn, "CREATE TABLE t (id INTEGER PRIMARY KEY)")
  end)
end

rats "open with file: URI"
  path = "file:#{test.tmpdir()}/uri_test.db"
  with_database(path, fn(conn)
    sqlite.exec(conn, "CREATE TABLE t (id INTEGER PRIMARY KEY)")
    sqlite.exec(conn, "INSERT INTO t VALUES (1)")
    test.assert_eq(sqlite.query_val(conn, "SELECT id FROM t"), 1)
  end)
end

rats "open with mode=memory and cache=shared"
  with_database("file:shared_test?mode=memory&cache=shared", fn(conn)
    sqlite.exec(conn, "CREATE TABLE t (id INTEGER PRIMARY KEY, v TEXT)")
    sqlite.exec(conn, "INSERT INTO t (v) VALUES (?)", "shared")
    test.assert_eq(sqlite.query_val(conn, "SELECT v FROM t"), "shared")
  end)
end

rats "open with mode=ro fails on non-existent file"
  message = database_error(fn()
    with_database("file:no_such_file.db?mode=ro", fn(conn) nil end)
  end)
  test.assert_contains message, "sqlite.open:"
end

rats "close on already-closed connection is safe"
  with_database(":memory:", fn(conn)
    sqlite.close(conn)
    # database/sql allows double-close without error.
    result = try sqlite.close(conn) or "should not error"
    test.assert_nil result
  end)
end

rats "exec DDL returns 0"
  with_table(fn(conn)
    affected = sqlite.exec(conn, "CREATE TABLE t2 (id INTEGER PRIMARY KEY)")
    test.assert_eq affected, 0
  end)
end

rats "exec INSERT returns rows affected"
  with_table(fn(conn)
    affected = sqlite.exec(conn, "INSERT INTO t (name) VALUES (?)", "Alice")
    test.assert_eq affected, 1
  end)
end

rats "exec UPDATE returns rows affected"
  with_table(fn(conn)
    sqlite.exec(conn, "INSERT INTO t (name) VALUES (?)", "Alice")
    sqlite.exec(conn, "INSERT INTO t (name) VALUES (?)", "Bob")
    affected = sqlite.exec(conn, "UPDATE t SET name = ? WHERE name = ?", "Alicia", "Alice")
    test.assert_eq affected, 1
  end)
end

rats "exec DELETE returns rows affected"
  with_table(fn(conn)
    sqlite.exec(conn, "INSERT INTO t (name) VALUES (?)", "Alice")
    sqlite.exec(conn, "INSERT INTO t (name) VALUES (?)", "Bob")
    affected = sqlite.exec(conn, "DELETE FROM t")
    test.assert_eq affected, 2
  end)
end

rats "exec bad SQL panics with sqlite.exec prefix"
  with_table(fn(conn)
    message = database_error(fn() sqlite.exec(conn, "INVALID SQL") end)
    test.assert_contains message, "sqlite.exec:"
  end)
end

rats "query returns array of hashes"
  with_table(fn(conn)
    sqlite.exec(conn, "INSERT INTO t (name, score) VALUES (?, ?)", "Alice", 9.5)
    sqlite.exec(conn, "INSERT INTO t (name, score) VALUES (?, ?)", "Bob", 8.0)
    rows = sqlite.query(conn, "SELECT name, score FROM t ORDER BY name")
    test.assert_eq rows, [{name: "Alice", score: 9.5}, {name: "Bob", score: 8.0}]
  end)
end

rats "query empty result returns empty array"
  with_table(fn(conn)
    rows = sqlite.query(conn, "SELECT * FROM t")
    test.assert_eq rows, []
  end)
end

rats "INTEGER columns normalize to int"
  with_table(fn(conn)
    sqlite.exec(conn, "INSERT INTO t (name) VALUES (?)", "test")
    row = sqlite.query_row(conn, "SELECT id FROM t")
    test.assert_eq(type_of(row.id), "Integer")
    test.assert_eq row, {id: 1}
  end)
end

rats "REAL columns normalize to float"
  with_table(fn(conn)
    sqlite.exec(conn, "INSERT INTO t (name, score) VALUES (?, ?)", "test", 3.14)
    row = sqlite.query_row(conn, "SELECT score FROM t")
    test.assert_eq(type_of(row.score), "Float")
    test.assert_eq row, {score: 3.14}
  end)
end

rats "TEXT columns normalize to string"
  with_table(fn(conn)
    sqlite.exec(conn, "INSERT INTO t (name) VALUES (?)", "hello")
    row = sqlite.query_row(conn, "SELECT name FROM t")
    test.assert_eq(type_of(row.name), "String")
    test.assert_eq row, {name: "hello"}
  end)
end

rats "NULL columns normalize to nil"
  with_table(fn(conn)
    sqlite.exec(conn, "INSERT INTO t (name) VALUES (?)", "test")
    row = sqlite.query_row(conn, "SELECT score FROM t")
    test.assert_eq row, {score: nil}
  end)
end

rats "query_row returns hash on hit"
  with_table(fn(conn)
    sqlite.exec(conn, "INSERT INTO t (name) VALUES (?)", "Alice")
    row = sqlite.query_row(conn, "SELECT * FROM t WHERE name = ?", "Alice")
    test.assert_eq row, {id: 1, name: "Alice", score: nil, data: nil, flag: nil}
  end)
end

rats "query_row returns nil on miss"
  with_table(fn(conn)
    row = sqlite.query_row(conn, "SELECT * FROM t WHERE name = ?", "nobody")
    test.assert_nil row
  end)
end

rats "query_val returns scalar"
  with_table(fn(conn)
    sqlite.exec(conn, "INSERT INTO t (name) VALUES (?)", "Alice")
    sqlite.exec(conn, "INSERT INTO t (name) VALUES (?)", "Bob")
    count = sqlite.query_val(conn, "SELECT COUNT(*) FROM t")
    test.assert_eq count, 2
  end)
end

rats "query_val returns nil on empty result"
  with_table(fn(conn)
    value = sqlite.query_val(conn, "SELECT name FROM t WHERE id = ?", 999)
    test.assert_nil value
  end)
end

rats "query_val returns string value"
  with_table(fn(conn)
    sqlite.exec(conn, "INSERT INTO t (name) VALUES (?)", "Alice")
    value = sqlite.query_val(conn, "SELECT name FROM t LIMIT 1")
    test.assert_eq value, "Alice"
  end)
end

rats "params bind string, int, float, nil"
  with_table(fn(conn)
    sqlite.exec(conn, "INSERT INTO t (name, score, data) VALUES (?, ?, ?)", "test", 42, nil)
    row = sqlite.query_row(conn, "SELECT * FROM t WHERE name = ?", "test")
    test.assert_eq row, {id: 1, name: "test", score: 42.0, data: nil, flag: nil}

    # The historical integer binding above did not exercise a Float argument.
    sqlite.exec(conn, "INSERT INTO t (name, score, data) VALUES (?, ?, ?)", "fractional", 2.5, nil)
    row = sqlite.query_row(conn, "SELECT * FROM t WHERE name = ?", "fractional")
    test.assert_eq row, {id: 2, name: "fractional", score: 2.5, data: nil, flag: nil}
  end)
end

rats "params prevent SQL injection"
  with_table(fn(conn)
    sqlite.exec(conn, "INSERT INTO t (name) VALUES (?)", "Alice")
    evil = "'; DROP TABLE t; --"
    sqlite.exec(conn, "INSERT INTO t (name) VALUES (?)", evil)
    rows = sqlite.query(conn, "SELECT * FROM t")
    test.assert_eq(len(rows), 2)
    row = sqlite.query_row(conn, "SELECT name FROM t WHERE name = ?", evil)
    test.assert_eq row, {name: evil}
  end)
end

rats "passing non-connection to exec panics with readable message"
  message = database_error(fn() sqlite.exec("not a conn", "SELECT 1") end)
  test.assert_contains message, "sqlite.exec:"
  test.assert_contains message, "expected a connection from sqlite.open"
end

rats "passing non-connection to query panics with readable message"
  message = database_error(fn() sqlite.query(42, "SELECT 1") end)
  test.assert_contains message, "sqlite.query:"
  test.assert_contains message, "expected a connection from sqlite.open"
end

rats "multiple connections are independent"
  with_database(":memory:", fn(first)
    with_database(":memory:", fn(second)
      sqlite.exec(first, "CREATE TABLE t (id INTEGER PRIMARY KEY, v TEXT)")
      sqlite.exec(second, "CREATE TABLE t (id INTEGER PRIMARY KEY, v TEXT)")
      sqlite.exec(first, "INSERT INTO t (v) VALUES (?)", "from_c1")
      sqlite.exec(second, "INSERT INTO t (v) VALUES (?)", "from_c2")
      test.assert_eq(sqlite.query_val(first, "SELECT v FROM t"), "from_c1")
      test.assert_eq(sqlite.query_val(second, "SELECT v FROM t"), "from_c2")
    end)
  end)
end

rats "unicode data round-trips correctly"
  with_table(fn(conn)
    sqlite.exec(conn, "INSERT INTO t (name) VALUES (?)", "日本語テスト 🚀")
    value = sqlite.query_val(conn, "SELECT name FROM t")
    test.assert_eq value, "日本語テスト 🚀"
  end)
end

rats "transactions via exec BEGIN/COMMIT"
  with_table(fn(conn)
    sqlite.exec(conn, "BEGIN")
    sqlite.exec(conn, "INSERT INTO t (name) VALUES (?)", "Alice")
    sqlite.exec(conn, "INSERT INTO t (name) VALUES (?)", "Bob")
    sqlite.exec(conn, "COMMIT")
    test.assert_eq(sqlite.query_val(conn, "SELECT COUNT(*) FROM t"), 2)
  end)
end

rats "transactions via exec ROLLBACK"
  with_table(fn(conn)
    sqlite.exec(conn, "INSERT INTO t (name) VALUES (?)", "before")
    sqlite.exec(conn, "BEGIN")
    sqlite.exec(conn, "INSERT INTO t (name) VALUES (?)", "rolled_back")
    sqlite.exec(conn, "ROLLBACK")
    test.assert_eq(sqlite.query_val(conn, "SELECT COUNT(*) FROM t"), 1)
    test.assert_eq(sqlite.query_val(conn, "SELECT name FROM t"), "before")
  end)
end

rats "try/or catches exec error with default value"
  with_table(fn(conn)
    result = try sqlite.exec(conn, "INSERT INTO nonexistent VALUES (1)") or -1
    test.assert_eq result, -1
  end)
end

rats "try/or catches exec error with error message"
  with_table(fn(conn)
    message = database_error(fn() sqlite.exec(conn, "INSERT INTO nonexistent VALUES (1)") end)
    test.assert_contains message, "sqlite.exec:"
    test.assert_contains message, "nonexistent"
  end)
end

rats "try/or catches query error with default value"
  with_table(fn(conn)
    result = try sqlite.query(conn, "SELECT * FROM nonexistent") or []
    test.assert_eq result, []
  end)
end

rats "pragma journal_mode WAL"
  path = "#{test.tmpdir()}/wal_test.db"
  with_database(path, fn(conn)
    sqlite.exec(conn, "PRAGMA journal_mode=WAL")
    mode = sqlite.query_val(conn, "PRAGMA journal_mode")
    test.assert_eq mode, "wal"
  end)
end

rats "pragma busy_timeout"
  with_database(":memory:", fn(conn)
    sqlite.exec(conn, "PRAGMA busy_timeout=5000")
    value = sqlite.query_val(conn, "PRAGMA busy_timeout")
    test.assert_eq value, 5000
  end)
end

rats "pragma foreign_keys"
  with_database(":memory:", fn(conn)
    sqlite.exec(conn, "PRAGMA foreign_keys=ON")
    value = sqlite.query_val(conn, "PRAGMA foreign_keys")
    test.assert_eq value, 1
  end)
end

rats "pragma query returns rows"
  with_database(":memory:", fn(conn)
    sqlite.exec(conn, "CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT)")
    rows = sqlite.query(conn, "PRAGMA table_info(t)")
    test.assert_eq(rows, [
      {cid: 0, name: "id", type: "INTEGER", notnull: 0, dflt_value: nil, pk: 1},
      {cid: 1, name: "name", type: "TEXT", notnull: 0, dflt_value: nil, pk: 0}
    ])
  end)
end

rats "database scope closes its connection after success"
  saved = nil
  result = with_database(":memory:", fn(conn)
    saved = conn
    sqlite.query_val(conn, "SELECT 42")
  end)

  test.assert_eq result, 42
  message = database_error(fn() sqlite.query_val(saved, "SELECT 1") end)
  test.assert_contains message, "database is closed"
end

rats "database scopes close both connections after an assertion failure"
  first = nil
  second = nil
  fail_inside_scopes = fn()
    with_database(":memory:", fn(outer)
      first = outer
      with_database(":memory:", fn(inner)
        second = inner
        test.assert_eq("actual", "expected")
      end)
    end)
  end
  failure = try fail_inside_scopes() or err
    (err)
  end

  test.assert_contains failure, "assert_eq failed"
  test.assert_contains failure, "actual"
  test.assert_contains failure, "expected"
  for conn in [first, second]
    message = database_error(fn() sqlite.query_val(conn, "SELECT 1") end)
    test.assert_contains message, "database is closed"
  end
end

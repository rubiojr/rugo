# RATS: Array transformations, queries, ordering, and method chains.
use "test"

# map

rats "array.map transforms each element"
  numbers = [1, 2, 3]

  doubled = numbers.map(fn(n) n * 2 end)

  test.assert_eq doubled, [2, 4, 6]
end

rats "array.map on empty array returns empty"
  result = [].map(fn(x) x * 2 end)
  test.assert_eq result, []
end

# filter

rats "array.filter keeps matching elements"
  numbers = [1, 2, 3, 4, 5]

  filtered = numbers.filter(fn(n) n > 3 end)

  test.assert_eq filtered, [4, 5]
end

rats "array.filter on empty array returns empty"
  result = [].filter(fn(x) x > 0 end)
  test.assert_eq result, []
end

# reject

rats "array.reject removes matching elements"
  numbers = [1, 2, 3, 4, 5]

  kept = numbers.reject(fn(n) n > 3 end)

  test.assert_eq kept, [1, 2, 3]
end

# each

rats "array.each iterates with side effects"
  numbers = [10, 20, 30]
  visited = []

  numbers.each(fn(number)
    append visited, number
  end)

  test.assert_eq visited, [10, 20, 30]
  test.assert_eq numbers, [10, 20, 30]
end

# reduce

rats "array.reduce accumulates a result"
  numbers = [1, 2, 3, 4, 5]

  total = numbers.reduce(0, fn(sum, n) sum + n end)

  test.assert_eq total, 15
end

rats "array.reduce with string accumulator"
  words = ["hello", "world"]

  sentence = words.reduce("", fn(text, word) text + word + " " end)

  test.assert_eq sentence, "hello world "
end

# find

rats "array.find returns first matching element"
  numbers = [1, 2, 3, 4, 5]

  found = numbers.find(fn(n) n > 3 end)

  test.assert_eq found, 4
end

rats "array.find returns nil when no match"
  numbers = [1, 2, 3]

  found = numbers.find(fn(n) n > 10 end)

  test.assert_nil found
end

# any / all

rats "array.any returns true when match exists"
  test.assert_true([1, 2, 3].any(fn(x) x > 2 end))
end

rats "array.any returns false when no match"
  test.assert_false([1, 2, 3].any(fn(x) x > 10 end))
end

rats "array.all returns true when all match"
  test.assert_true([1, 2, 3].all(fn(x) x > 0 end))
end

rats "array.all returns false when one fails"
  test.assert_false([1, 2, 3].all(fn(x) x > 1 end))
end

# count

rats "array.count counts matching elements"
  numbers = [1, 2, 3, 4, 5]
  test.assert_eq(numbers.count(fn(n) n > 2 end), 3)
end

# join

rats "array.join with separator"
  words = ["a", "b", "c"]
  test.assert_eq(words.join(", "), "a, b, c")
end

rats "array.join with empty separator"
  letters = ["x", "y", "z"]
  test.assert_eq(letters.join(""), "xyz")
end

rats "array.join converts non-strings"
  numbers = [1, 2, 3]
  test.assert_eq(numbers.join("-"), "1-2-3")
end

# first / last

rats "array.first returns first element"
  test.assert_eq([10, 20, 30].first(), 10)
end

rats "array.last returns last element"
  test.assert_eq([10, 20, 30].last(), 30)
end

rats "array.first on empty returns nil"
  test.assert_nil([].first())
end

# min / max / sum

rats "array.min returns minimum value"
  test.assert_eq([3, 1, 4, 1, 5].min(), 1)
end

rats "array.max returns maximum value"
  test.assert_eq([3, 1, 4, 1, 5].max(), 5)
end

rats "array.sum returns total"
  test.assert_eq([10, 20, 30].sum(), 60)
end

# flatten / uniq

rats "array.flatten one level deep"
  nested = [[1, 2], [3, 4], 5]

  flattened = nested.flatten()

  test.assert_eq flattened, [1, 2, 3, 4, 5]
end

rats "array.uniq removes duplicates preserving order"
  result = [1, 2, 2, 3, 1].uniq()
  test.assert_eq result, [1, 2, 3]
end

# sort_by

rats "array.sort_by sorts by lambda result"
  fruits = ["banana", "apple", "cherry", "fig"]

  sorted = fruits.sort_by(fn(fruit) len(fruit) end)

  test.assert_eq sorted, ["fig", "apple", "banana", "cherry"]
end

rats "array.sort_by does not mutate original"
  numbers = [3, 1, 2]

  sorted = numbers.sort_by(fn(n) n end)

  test.assert_eq numbers, [3, 1, 2]
  test.assert_eq sorted, [1, 2, 3]
end

# flat_map

rats "array.flat_map maps and flattens"
  result = [1, 2, 3].flat_map(fn(x) [x, x * 10] end)
  test.assert_eq result, [1, 10, 2, 20, 3, 30]
end

# take / drop

rats "array.take returns first n elements"
  result = [1, 2, 3, 4, 5].take(3)
  test.assert_eq result, [1, 2, 3]
end

rats "array.drop returns all but first n"
  result = [1, 2, 3, 4, 5].drop(3)
  test.assert_eq result, [4, 5]
end

# zip

rats "array.zip pairs elements from two arrays"
  numbers = [1, 2, 3]
  letters = ["x", "y", "z"]

  pairs = numbers.zip(letters)

  test.assert_eq pairs, [[1, "x"], [2, "y"], [3, "z"]]
end

# chunk

rats "array.chunk splits into groups"
  chunks = [1, 2, 3, 4, 5].chunk(2)
  test.assert_eq chunks, [[1, 2], [3, 4], [5]]
end

# Chaining

rats "array method chaining works"
  result = [1, 2, 3, 4, 5]
    .filter(fn(n) n > 2 end)
    .map(fn(n) n * 10 end)
    .join(" + ")

  test.assert_eq result, "30 + 40 + 50"
end

rats "array map then reduce chain"
  result = [1, 2, 3]
    .map(fn(n) n * n end)
    .reduce(0, fn(sum, n) sum + n end)

  test.assert_eq result, 14
end

# contains

rats "array.contains returns true when value is present"
  test.assert_true([1, 2, 3].contains(2))
end

rats "array.contains returns false when value is absent"
  test.assert_false([1, 2, 3].contains(99))
end

rats "array.contains works with strings"
  test.assert_true(["a", "b", "c"].contains("b"))
  test.assert_false(["a", "b", "c"].contains("z"))
end

rats "array.contains on empty array returns false"
  test.assert_false([].contains(1))
end

rats "array.contains uses deep equality"
  test.assert_true([[1, 2], [3, 4]].contains([3, 4]))
  test.assert_false([[1, 2], [3, 4]].contains([5, 6]))
end

# index

rats "array.index returns index of first occurrence"
  test.assert_eq([10, 20, 30, 20].index(20), 1)
end

rats "array.index returns -1 when not found"
  test.assert_eq([1, 2, 3].index(99), -1)
end

rats "array.index on empty array returns -1"
  test.assert_eq([].index(1), -1)
end

rats "array.index works with strings"
  test.assert_eq(["a", "b", "c"].index("c"), 2)
end

rats "array.index uses deep equality"
  test.assert_eq([[1], [2], [3]].index([2]), 1)
end

# reverse

rats "array.reverse returns new reversed array"
  result = [1, 2, 3].reverse()
  test.assert_eq result, [3, 2, 1]
end

rats "array.reverse on empty array returns empty"
  test.assert_eq([].reverse(), [])
end

rats "array.reverse does not mutate original"
  numbers = [1, 2, 3]

  reversed = numbers.reverse()

  test.assert_eq numbers, [1, 2, 3]
  test.assert_eq reversed, [3, 2, 1]
end

rats "array.reverse on single element"
  result = [42].reverse()
  test.assert_eq result, [42]
end

# compact

rats "array.compact removes consecutive duplicates"
  result = [1, 1, 2, 2, 2, 3, 1, 1].compact()
  test.assert_eq result, [1, 2, 3, 1]
end

rats "array.compact on empty array returns empty"
  test.assert_eq([].compact(), [])
end

rats "array.compact with no consecutive duplicates"
  result = [1, 2, 3].compact()
  test.assert_eq result, [1, 2, 3]
end

rats "array.compact on single element"
  result = [42].compact()
  test.assert_eq result, [42]
end

rats "array.compact works with strings"
  result = ["a", "a", "b", "b", "a"].compact()
  test.assert_eq result, ["a", "b", "a"]
end

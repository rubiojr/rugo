# RATS: Optional type annotations on def/fn params and return types
use "test"
use "eval"
use "os"
use "str"

# =====================================================================
# Section 1 — Basic positive cases
# =====================================================================

rats "annotated function with int params and int return"
  source = <<~RUGO
    def add(a : int, b : int) : int
      return a + b
    end
    puts(add(2, 3))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "5")
end

rats "annotated function with string params and string return"
  source = <<~RUGO
    def greet(name : string) : string
      return "hello, " + name
    end
    puts(greet("rugo"))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "hello, rugo")
end

rats "annotated function with float params and float return"
  source = <<~RUGO
    def avg(a : float, b : float) : float
      return (a + b) / 2.0
    end
    puts(avg(1.0, 3.0))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_contains(result["output"], "2")
end

rats "annotated function with bool params and bool return"
  source = <<~RUGO
    def both(a : bool, b : bool) : bool
      return a && b
    end
    puts(both(true, true))
    puts(both(true, false))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_contains(result["output"], "true")
  test.assert_contains(result["output"], "false")
end

rats "annotated function returning bool from comparison"
  source = <<~RUGO
    def eq(a : int, b : int) : bool
      return a == b
    end
    puts(eq(2, 2))
    puts(eq(2, 3))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_contains(result["output"], "true")
  test.assert_contains(result["output"], "false")
end

rats "no-arg function with only a return annotation"
  source = <<~RUGO
    def pi() : float
      return 3.14159
    end
    puts(pi())
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "3.14159")
end

# =====================================================================
# Section 2 — Every documented type name works
# =====================================================================

rats "int param and int return"
  source = <<~RUGO
    def f(x : int) : int
      return x + 1
    end
    puts(f(41))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "42")
end

rats "float param and float return"
  source = <<~RUGO
    def f(x : float) : float
      return x * 2.0
    end
    puts(f(1.5))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "3.0")
end

rats "string param and string return"
  source = <<~RUGO
    def f(x : string) : string
      return x + "!"
    end
    puts(f("hi"))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "hi!")
end

rats "bool param and bool return"
  source = <<~RUGO
    def f(x : bool) : bool
      return !x
    end
    puts(f(true))
    puts(f(false))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_contains(result["output"], "false")
  test.assert_contains(result["output"], "true")
end

rats "array param and array return"
  source = <<~RUGO
    def first(arr : array) : array
      return [arr[0]]
    end
    puts(first([10, 20, 30]))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "[10]")
end

rats "hash param round-trips"
  source = <<~RUGO
    def keys(h : hash) : array
      return h.keys()
    end
    out = keys({a: 1, b: 2})
    puts(out.contains("a"))
    puts(out.contains("b"))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_contains(result["output"], "true")
end

rats "nil annotation on return type"
  source = <<~RUGO
    def f() : nil
      return nil
    end
    puts(f())
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "nil")
end

rats "nil annotation on param"
  source = <<~RUGO
    def f(x : nil) : any
      return x
    end
    puts(f(nil))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "nil")
end

rats "any as param and return is the explicit dynamic escape hatch"
  source = <<~RUGO
    def echo(x : any) : any
      return x
    end
    puts(echo(42))
    puts(echo("hello"))
    puts(echo(true))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_contains(result["output"], "42")
  test.assert_contains(result["output"], "hello")
  test.assert_contains(result["output"], "true")
end

# =====================================================================
# Section 3 — Mixing annotated and unannotated parameters
# =====================================================================

rats "annotation only on first parameter"
  source = <<~RUGO
    def f(a : int, b)
      return a + b
    end
    puts(f(2, 3))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "5")
end

rats "annotation only on last parameter"
  source = <<~RUGO
    def f(a, b : int)
      return a + b
    end
    puts(f(2, 3))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "5")
end

rats "annotation only on a middle parameter"
  source = <<~RUGO
    def f(a, b : int, c)
      return a + b + c
    end
    puts(f(1, 2, 3))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "6")
end

rats "return-only annotation, no param annotations"
  source = <<~RUGO
    def label(x) : string
      return "n=" + x
    end
    puts(label("42"))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "n=42")
end

# =====================================================================
# Section 4 — Annotation interaction with default values
# =====================================================================

rats "annotated param with default value"
  source = <<~RUGO
    def greet(name : string = "world") : string
      return "hi, " + name
    end
    puts(greet())
    puts(greet("rugo"))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_contains(result["output"], "hi, world")
  test.assert_contains(result["output"], "hi, rugo")
end

rats "annotation plus default on single int param"
  source = <<~RUGO
    def inc(a : int = 5) : int
      return a + 1
    end
    puts(inc())
    puts(inc(10))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_contains(result["output"], "6")
  test.assert_contains(result["output"], "11")
end

rats "mixed annotated and default in same signature"
  source = <<~RUGO
    def f(a : int, b : int = 10) : int
      return a + b
    end
    puts(f(2))
    puts(f(2, 3))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_contains(result["output"], "12")
  test.assert_contains(result["output"], "5")
end

# =====================================================================
# Section 5 — fn lambdas with annotations
# =====================================================================

rats "fn lambda with int param and return"
  source = <<~RUGO
    double = fn(x : int) : int
      return x * 2
    end
    puts(double(21))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "42")
end

rats "fn lambda passed as higher-order argument"
  source = <<~RUGO
    def apply(f, x)
      return f(x)
    end
    inc = fn(n : int) : int
      return n + 1
    end
    puts(apply(inc, 41))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "42")
end

rats "typed fn lambda used with array.map"
  source = <<~RUGO
    arr = [1, 2, 3]
    out = arr.map(fn(x : int) : int
      return x * 10
    end)
    puts(out)
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "[10, 20, 30]")
end

rats "fn lambda with nil return annotation"
  source = <<~RUGO
    f = fn() : nil
      return nil
    end
    puts(f())
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "nil")
end

# =====================================================================
# Section 6 — Semantic correctness inside annotated functions
# =====================================================================

rats "integer division returns int"
  source = <<~RUGO
    def div(a : int, b : int) : int
      return a / b
    end
    puts(div(10, 3))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "3")
end

rats "recursive annotated function (factorial)"
  source = <<~RUGO
    def factorial(n : int) : int
      if n <= 1
        return 1
      end
      return n * factorial(n - 1)
    end
    puts(factorial(5))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "120")
end

rats "mutually recursive annotated functions"
  source = <<~RUGO
    def is_even(n : int) : bool
      if n == 0
        return true
      end
      return is_odd(n - 1)
    end
    def is_odd(n : int) : bool
      if n == 0
        return false
      end
      return is_even(n - 1)
    end
    puts(is_even(4))
    puts(is_odd(7))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_contains(result["output"], "true")
end

rats "annotated function with multiple return branches"
  source = <<~RUGO
    def sign(n : int) : string
      if n > 0
        return "positive"
      end
      if n < 0
        return "negative"
      end
      return "zero"
    end
    puts(sign(5))
    puts(sign(-1))
    puts(sign(0))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_contains(result["output"], "positive")
  test.assert_contains(result["output"], "negative")
  test.assert_contains(result["output"], "zero")
end

rats "typed-return function relying on coercion of dynamic body"
  source = <<~RUGO
    use "math"
    def hypot(a : float, b : float) : float
      return math.sqrt(a * a + b * b)
    end
    puts(hypot(3.0, 4.0))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_contains(result["output"], "5")
end

# =====================================================================
# Section 7 — Interaction with other language features
# =====================================================================

rats "annotated function chained through pipe"
  source = <<~RUGO
    def shout(s : string) : string
      return s + "!"
    end
    echo "hi" | shout | puts
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_contains(result["output"], "hi!")
end

rats "annotated function called from spawn"
  source = <<~RUGO
    def add(a : int, b : int) : int
      return a + b
    end
    t = spawn add(2, 3)
    puts(t.value)
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "5")
end

rats "annotated functions chained"
  source = <<~RUGO
    def inc(n : int) : int
      return n + 1
    end
    def dbl(n : int) : int
      return n * 2
    end
    puts(dbl(inc(5)))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "12")
end

# =====================================================================
# Section 8 — Value coercion at the call site
#
# Rugo's annotated params perform implicit conversion when the caller
# supplies a different but representable type (e.g. int -> float,
# bool -> int, int -> string). Conversions that cannot succeed (e.g.
# non-numeric string -> int) error at runtime with a clear message.
# =====================================================================

rats "int argument coerced to float param"
  source = <<~RUGO
    def f(a : float, b : float) : float
      return a + b
    end
    puts(f(3, 4))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "7.0")
end

rats "int argument coerced to string param"
  source = <<~RUGO
    def f(a : string) : string
      return a
    end
    puts(f(42))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "42")
end

rats "bool argument coerced to int param"
  source = <<~RUGO
    def f(a : int) : int
      return a
    end
    puts(f(true))
    puts(f(false))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_contains(result["output"], "1")
  test.assert_contains(result["output"], "0")
end

rats "non-numeric string literal as int argument is a compile error"
  source = <<~RUGO
    def add(a : int, b : int) : int
      return a + b
    end
    puts(add("xyz", "abc"))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass string literal as argument 1 to 'add'")
  test.assert_contains(combined, "parameter 'a' declared as int")
end

# =====================================================================
# Section 9 — Negative tests: invalid type names
# =====================================================================

rats "unknown type name in param produces compile error"
  source = <<~RUGO
    def f(x : integer) : int
      return x
    end
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"] + result["output"], "unknown type")
  test.assert_contains(result["output"] + result["output"], "integer")
end

rats "unknown type name in return produces compile error"
  source = <<~RUGO
    def f(x) : integer
      return x
    end
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"] + result["output"], "unknown return type")
end

rats "capitalized type name rejected (case sensitive)"
  source = <<~RUGO
    def f(x : Int) : Int
      return x
    end
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"] + result["output"], "unknown type")
  test.assert_contains(result["output"] + result["output"], "Int")
end

rats "capitalized nil keyword as type rejected"
  source = <<~RUGO
    def f() : Nil
      return nil
    end
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"] + result["output"], "unknown return type")
end

rats "uppercase type name rejected"
  source = <<~RUGO
    def f(x : INT) : INT
      return x
    end
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"] + result["output"], "unknown type")
end

rats "valid-types list appears in error message"
  source = <<~RUGO
    def f(x : foobar)
      return x
    end
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"] + result["output"], "int")
  test.assert_contains(result["output"] + result["output"], "float")
  test.assert_contains(result["output"] + result["output"], "string")
  test.assert_contains(result["output"] + result["output"], "any")
end

rats "unknown type name inside fn lambda param"
  source = <<~RUGO
    sq = fn(x : foobar) : int
      return x * x
    end
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"] + result["output"], "unknown type")
  test.assert_contains(result["output"] + result["output"], "fn parameter")
end

rats "unknown type name on fn lambda return"
  source = <<~RUGO
    sq = fn(x : int) : foobar
      return x * x
    end
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"] + result["output"], "unknown return type")
  test.assert_contains(result["output"] + result["output"], "fn lambda")
end

# =====================================================================
# Section 10 — Negative tests: invalid annotation syntax
# =====================================================================

rats "numeric literal in place of type name is a parse error"
  source = <<~RUGO
    def f(x : 42) : int
      return x
    end
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
end

rats "string literal in place of type name is a parse error"
  source = <<~RUGO
    def f(x : "int") : int
      return x
    end
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
end

rats "empty annotation after colon on param is a parse error"
  source = <<~RUGO
    def f(x : ) : int
      return x
    end
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
end

rats "empty annotation after colon on return is a parse error"
  source = <<~RUGO
    def f() : 
      return 1
    end
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
end

rats "double colon is a parse error"
  source = <<~RUGO
    def f(x : : int) : int
      return x
    end
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
end

# =====================================================================
# Section 11 — Generated-code shape
#
# These verify that annotations actually flow into the generated Go,
# producing typed signatures for primitives and interface{} for `any`.
# =====================================================================

rats "primitive annotations produce typed Go signatures"
  src = "def add(a : int, b : int) : int\n  return a + b\nend\nputs(add(2, 3))\n"
  path = test.tmpdir() + "/typed.rugo"
  test.write_file(path, src)
  result = test.run("rugo emit #{path}")
  test.assert_eq(result["status"], 0)
  test.assert_contains(result["output"], "func rugofn_add(a int, b int) int")
end

rats "string annotation produces typed Go string signature"
  src = "def greet(name : string) : string\n  return \"hi, \" + name\nend\nputs(greet(\"x\"))\n"
  path = test.tmpdir() + "/str.rugo"
  test.write_file(path, src)
  result = test.run("rugo emit #{path}")
  test.assert_eq(result["status"], 0)
  test.assert_contains(result["output"], "func rugofn_greet(name string) string")
end

rats "bool annotation produces typed Go bool signature"
  src = "def neg(x : bool) : bool\n  return !x\nend\nputs(neg(true))\n"
  path = test.tmpdir() + "/bool.rugo"
  test.write_file(path, src)
  result = test.run("rugo emit #{path}")
  test.assert_eq(result["status"], 0)
  test.assert_contains(result["output"], "func rugofn_neg(x bool) bool")
end

rats "any annotation produces interface{} Go signature"
  src = "def echo(x : any) : any\n  return x\nend\nputs(echo(1))\n"
  path = test.tmpdir() + "/any.rugo"
  test.write_file(path, src)
  result = test.run("rugo emit #{path}")
  test.assert_eq(result["status"], 0)
  test.assert_contains(result["output"], "func rugofn_echo(x interface{}) interface{}")
end

rats "array annotation does not produce typed Go array signature"
  src = "def first(arr : array) : array\n  return [arr[0]]\nend\nputs(first([1, 2]))\n"
  path = test.tmpdir() + "/arr.rugo"
  test.write_file(path, src)
  result = test.run("rugo emit #{path}")
  test.assert_eq(result["status"], 0)
  test.assert_contains(result["output"], "func rugofn_first(arr interface{}) interface{}")
end

rats "emit --stats reports annotation coverage"
  src = "def add(a : int, b : int) : int\n  return a + b\nend\ndef noop(a, b)\n  return nil\nend\nputs(add(1, 2))\n"
  path = test.tmpdir() + "/stats.rugo"
  test.write_file(path, src)
  result = test.run("rugo emit --stats #{path}")
  test.assert_eq(result["status"], 0)
  test.assert_contains(result["output"], "annotated:")
end

# =====================================================================
# Section 12 — Known limitations
#
# These pin current behaviour so changes get noticed. They are
# negative tests: if any of these STARTS to succeed, the limitation
# is gone and these tests should be updated.
# =====================================================================

rats "limitation: multi-line annotated parameter list is a parse error"
  source = <<~RUGO
    def add(
      a : int,
      b : int
    ) : int
      return a + b
    end
    puts(add(2, 3))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
end

rats "limitation: reassigning annotated int param to string in body errors"
  # Mismatch detection now catches this — see Section 13 below
  # for the full structured-diagnostic coverage. This test stays as a
  # smoke check that the exit status is non-zero.
  source = <<~RUGO
    def f(a : int)
      a = "hello"
      return a
    end
    puts(f(42))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
end

rats "limitation: no space before colon parses as hash-colon sugar"
  # The preprocessor rewrites `ident:` (no space) into `"ident" =>`,
  # so `def f(x:int)` is interpreted differently and the program ends
  # up running the un-annotated form. This is the documented reason
  # why a space before ':' is required for type annotations.
  source = <<~RUGO
    def f(x:int) : int
      return x
    end
    puts(f(5))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "5")
end

# =====================================================================
# Section 13 — Annotation/body mismatch detection
#
# Validate that the compile-time mismatch checker catches concrete
# conflicts between an annotation and the function body, producing a
# structured rugo-level error with a source location.
#
# Coverage:
#   - Reassigning an annotated param to an incompatible literal type
#   - Returning the wrong type via explicit `return`
#   - Implicit return (last-expression-as-value) of the wrong type
#   - The same patterns inside `fn` lambdas
#   - Numeric coercion (int <-> float) is allowed (no error)
#   - `string`, `bool`, `any` annotations accept anything (no error)
#   - Unannotated functions are not checked at all
# =====================================================================

rats "mismatch: reassigning annotated int param to string errors with structured message"
  source = <<~RUGO
    def f(a : int)
      a = "hello"
    end
    puts(f(1))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot assign string value to parameter 'a' declared as int")
end

rats "mismatch: error points at the rugo source line, not generated Go"
  source = <<~RUGO
    def f(a : int)
      a = "hello"
    end
    puts(f(1))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, ":2:")
end

rats "mismatch: reassigning annotated float param to string errors"
  source = <<~RUGO
    def f(a : float)
      a = "oops"
    end
    f(1.0)
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot assign string value to parameter 'a' declared as float")
end

rats "mismatch: reassigning annotated array param to int errors"
  source = <<~RUGO
    def f(a : array)
      a = 42
    end
    f([1, 2, 3])
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot assign int value to parameter 'a' declared as array")
end

rats "mismatch: reassigning annotated hash param to array errors"
  source = <<~RUGO
    def f(h : hash)
      h = [1, 2, 3]
    end
    f({a: 1})
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot assign array value to parameter 'h' declared as hash")
end

rats "mismatch: reassigning annotated nil param to int errors"
  source = <<~RUGO
    def f(x : nil)
      x = 42
    end
    f(nil)
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot assign int value to parameter 'x' declared as nil")
end

rats "mismatch: int -> float param reassignment errors (strict assign rule)"
  source = <<~RUGO
    def f(a : int)
      a = 3.14
      return a
    end
    puts(f(1))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot assign float value to parameter 'a' declared as int")
end

rats "mismatch: float -> int param reassignment errors (strict assign rule)"
  source = <<~RUGO
    def f(a : float)
      a = 7
      return a
    end
    puts(f(1.0))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot assign int value to parameter 'a' declared as float")
end

rats "mismatch: string annotation rejects non-string reassignment (strict)"
  source = <<~RUGO
    def f(s : string)
      s = 42
      return s
    end
    puts(f("hi"))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot assign int value to parameter 's' declared as string")
end

rats "mismatch: bool annotation rejects non-bool reassignment (strict)"
  source = <<~RUGO
    def f(b : bool)
      b = "anything"
      return b
    end
    puts(f(true))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot assign string value to parameter 'b' declared as bool")
end

rats "mismatch: same-type reassignment is fine (int -> int)"
  source = <<~RUGO
    def f(a : int)
      a = 99
      return a
    end
    puts(f(1))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "99")
end

rats "mismatch: same-type reassignment is fine (string -> string)"
  source = <<~RUGO
    def f(s : string)
      s = "new value"
      return s
    end
    puts(f("old"))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "new value")
end

rats "mismatch: any annotation accepts any reassignment"
  source = <<~RUGO
    def f(x : any)
      x = "ok"
      x = 42
      x = [1, 2]
      return x
    end
    puts(f(1))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
end

rats "mismatch: returning string from int-annotated function errors"
  source = <<~RUGO
    def f() : int
      return "hi"
    end
    puts(f())
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot return string value from function declared returning int")
end

rats "mismatch: returning array from int-annotated function errors"
  source = <<~RUGO
    def f() : int
      return [1, 2, 3]
    end
    f()
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot return array value from function declared returning int")
end

rats "mismatch: returning int from nil-annotated function errors"
  source = <<~RUGO
    def f() : nil
      return 42
    end
    f()
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot return int value from function declared returning nil")
end

rats "mismatch: returning hash from array-annotated function errors"
  source = <<~RUGO
    def f() : array
      return {a: 1}
    end
    f()
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot return hash value from function declared returning array")
end

rats "mismatch: int -> float return is allowed (numeric coercion)"
  source = <<~RUGO
    def f() : float
      return 42
    end
    puts(f())
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
end

rats "mismatch: float -> int return is allowed (numeric coercion)"
  source = <<~RUGO
    def f() : int
      return 3.14
    end
    puts(f())
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
end

rats "mismatch: returning anything from string-annotated function is allowed"
  source = <<~RUGO
    def f() : string
      return 42
    end
    puts(f())
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
end

rats "mismatch: any-annotated return accepts anything"
  source = <<~RUGO
    def f() : any
      return [1, 2, 3]
    end
    f()
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
end

rats "mismatch: implicit return of wrong type errors"
  source = <<~RUGO
    def f() : int
      "hello"
    end
    f()
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot implicitly return string value")
end

rats "mismatch: implicit return of array from int-annotated function errors"
  source = <<~RUGO
    def f() : int
      [1, 2, 3]
    end
    f()
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot implicitly return array value")
end

rats "mismatch: fn lambda param reassignment to wrong type errors"
  source = <<~RUGO
    f = fn(a : int)
      a = "oops"
    end
    f(1)
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot assign string value to parameter 'a' declared as int")
end

rats "mismatch: fn lambda return-type mismatch errors"
  source = <<~RUGO
    f = fn() : int
      return "no"
    end
    f()
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot return string value from function declared returning int")
end

rats "mismatch: nested fn lambda inside def is also checked"
  source = <<~RUGO
    def outer()
      inner = fn(a : int)
        a = "oops"
      end
      return inner(1)
    end
    outer()
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot assign string value to parameter 'a' declared as int")
end

rats "mismatch: unannotated functions are not checked"
  source = <<~RUGO
    def f(a)
      a = "hello"
      a = 42
      a = [1, 2]
      return a
    end
    puts(f(0))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
end

rats "mismatch: branch-aware: each return checked independently"
  source = <<~RUGO
    def f(x : int) : int
      if x > 0
        return "positive"
      end
      return x
    end
    f(1)
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot return string value from function declared returning int")
end

rats "mismatch: only the conflicting return errors, valid returns are fine"
  source = <<~RUGO
    def f(x : int) : int
      if x > 0
        return x * 2
      end
      return 0
    end
    puts(f(5))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "10")
end

# =====================================================================
# Section 14 — Call-site argument mismatches with literal args
# =====================================================================
# When a literal argument is passed to a user-defined function with an
# annotated parameter and the literal type is incompatible with the
# annotation, the compiler emits an error pointing at the source line.

rats "call-site: string literal passed to int param errors"
  source = <<~RUGO
    def f(a : int) : int
      return a + 1
    end
    puts(f("oops"))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass string literal as argument 1 to 'f'")
  test.assert_contains(combined, "parameter 'a' declared as int")
end

rats "call-site: array literal passed to int param errors"
  source = <<~RUGO
    def f(a : int) : int
      return a
    end
    puts(f([1, 2, 3]))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass array literal")
  test.assert_contains(combined, "parameter 'a' declared as int")
end

rats "call-site: hash literal passed to array param errors"
  source = <<~RUGO
    def f(xs : array) : array
      return xs
    end
    puts(f({a: 1}))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass hash literal")
  test.assert_contains(combined, "parameter 'xs' declared as array")
end

rats "call-site: nil literal passed to int param errors"
  source = <<~RUGO
    def f(a : int)
      return a
    end
    puts(f(nil))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass nil literal")
end

rats "call-site: bool literal passed to array param errors"
  source = <<~RUGO
    def f(xs : array)
      return xs
    end
    puts(f(true))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass bool literal")
end

rats "call-site: error points at the rugo source line"
  source = <<~RUGO
    def f(a : int) : int
      return a + 1
    end

    puts(f("oops"))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, ":5:")
end

rats "call-site: second argument mismatch reports correct index"
  source = <<~RUGO
    def add(a : int, b : int) : int
      return a + b
    end
    puts(add(1, "x"))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "argument 2 to 'add'")
  test.assert_contains(combined, "parameter 'b' declared as int")
end

rats "call-site: variable arg is NOT flagged"
  source = <<~RUGO
    def add(a : int, b : int) : int
      return a + b
    end
    x = 5
    y = 7
    puts(add(x, y))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "12")
end

rats "call-site: module call arg is NOT flagged"
  source = <<~RUGO
    use "str"
    puts(str.upper(42))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "42")
end

rats "call-site: dot call (ns.f) is NOT flagged"
  source = <<~RUGO
    use "str"
    puts(str.upper("hi"))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "HI")
end

rats "call-site: int literal to float param is allowed (numeric coercion)"
  source = <<~RUGO
    def f(a : float) : float
      return a + 1.0
    end
    puts(f(2))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_contains(result["output"], "3")
end

rats "call-site: float literal to int param is allowed (numeric coercion)"
  source = <<~RUGO
    def f(a : int) : int
      return a + 1
    end
    puts(f(2.7))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
end

rats "call-site: int literal to string param is allowed (stringify)"
  source = <<~RUGO
    def f(a : string) : string
      return a
    end
    puts(f(42))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "42")
end

rats "call-site: any literal to string param is allowed"
  source = <<~RUGO
    def f(a : string) : string
      return a
    end
    puts(f([1, 2]))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
end

rats "call-site: anything to any-annotated param is allowed"
  source = <<~RUGO
    def f(x : any) : any
      return x
    end
    puts(f("anything"))
    puts(f(42))
    puts(f([1, 2]))
    puts(f(nil))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
end

rats "call-site: negative integer literal to int param is allowed"
  source = <<~RUGO
    def f(a : int) : int
      return a + 1
    end
    puts(f(-5))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "-4")
end

rats "call-site: negative integer literal to string param is allowed"
  source = <<~RUGO
    def f(a : string) : string
      return a
    end
    puts(f(-5))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
end

rats "call-site: literal-arg mismatch inside fn lambda body is caught"
  source = <<~RUGO
    def square(n : int) : int
      return n * n
    end
    f = fn()
      return square("oops")
    end
    puts(f())
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass string literal as argument 1 to 'square'")
end

rats "call-site: literal-arg mismatch in recursive self-call is caught"
  source = <<~RUGO
    def f(n : int) : int
      if n <= 0
        return 0
      end
      return f("oops")
    end
    puts(f(3))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass string literal as argument 1 to 'f'")
end

rats "call-site: literal-arg mismatch inside if condition is caught"
  source = <<~RUGO
    def is_pos(n : int) : bool
      return n > 0
    end
    if is_pos("oops")
      puts("yes")
    end
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass string literal as argument 1 to 'is_pos'")
end

rats "call-site: literal-arg mismatch inside spawn body is caught"
  source = <<~RUGO
    def square(n : int) : int
      return n * n
    end
    task = spawn
      square("nope")
    end
    puts(task.value)
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass string literal as argument 1 to 'square'")
end

rats "call-site: literal-arg mismatch inside try expression is caught"
  source = <<~RUGO
    def f(n : int) : int
      return n * 2
    end
    result = try f("oops") or 99
    puts(result)
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass string literal as argument 1 to 'f'")
end

rats "call-site: pipe sugar with wrong literal-type is caught"
  source = <<~RUGO
    def square(n : int) : int
      return n * n
    end
    puts(square("oops"))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass string literal as argument 1 to 'square'")
end

rats "call-site: unannotated function is NOT flagged"
  source = <<~RUGO
    def f(a)
      return a
    end
    puts(f("anything"))
    puts(f(42))
    puts(f([1, 2]))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
end

rats "call-site: function with default-arg + annotation still validates literals"
  source = <<~RUGO
    def add(a : int = 1, b : int = 2) : int
      return a + b
    end
    puts(add("oops", 10))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass string literal as argument 1 to 'add'")
end

rats "call-site: function with default-arg + annotation accepts valid args"
  source = <<~RUGO
    def add(a : int = 1, b : int = 2) : int
      return a + b
    end
    puts(add(5, 10))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "15")
end

rats "call-site: --no-infer disables the call-site check"
  tmp = test.tmpdir()
  src_path = tmp + "/no_infer_t2.rugo"
  test.write_file(src_path, "def f(a : int) : int\n  return a + 1\nend\nputs(f(\"oops\"))\n")
  result = test.run("rugo run --no-infer " + src_path)
  # With --no-infer the call-site check is skipped so we never see the
  # compile-time "cannot pass" message (program may succeed or fail at
  # runtime depending on the operation, but the compile error is gone).
  test.assert_true(!str.contains(result["output"], "cannot pass string literal"))
end

rats "call-site: bool literal to int param is allowed (numeric mutual)"
  source = <<~RUGO
    def f(a : int) : int
      return a
    end
    puts(f(true))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
end

rats "call-site: anything to bool param is allowed (truthiness)"
  source = <<~RUGO
    def f(a : bool) : bool
      return a
    end
    puts(f(0))
    puts(f("hi"))
    puts(f([1, 2]))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
end

# =====================================================================
# Section: Variable type annotations (`x : T = expr`)
# =====================================================================

rats "var annot: typed binding compiles and runs"
  source = <<~RUGO
    x : int = 42
    puts(x)
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "42")
end

rats "var annot: each builtin type name is accepted"
  source = <<~RUGO
    a : int = 1
    b : float = 1.5
    c : string = "hi"
    d : bool = true
    e : array = [1, 2]
    f : hash = {1 => 2}
    g : nil = nil
    h : any = 42
    puts(a)
    puts(b)
    puts(c)
    puts(d)
    puts(e)
    puts(g)
    puts(h)
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
end

rats "var annot: init type mismatch errors"
  source = <<~RUGO
    x : int = "hello"
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot assign string value to")
end

rats "var annot: reassign with incompatible type errors"
  source = <<~RUGO
    x : int = 0
    x = "hello"
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot assign string value to")
end

rats "var annot: any permits any reassignment"
  source = <<~RUGO
    x : any = 0
    x = "hello"
    x = [1, 2]
    puts(x)
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "[1, 2]")
end

rats "var annot: unknown type name errors with valid type hint"
  source = <<~RUGO
    x : foobar = 0
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "unknown type")
  test.assert_contains(result["output"], "foobar")
end

rats "var annot: re-annotation in same scope errors"
  source = <<~RUGO
    x : int = 0
    x : int = 1
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "re-annotation")
end

rats "var annot: unannotated path still permits mixed reassignment"
  source = <<~RUGO
    x = 1
    x = "hello"
    puts(x)
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "hello")
end

rats "var annot: inside function body"
  source = <<~RUGO
    def f()
      x : int = 10
      return x * 2
    end
    puts(f())
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "20")
end

rats "var annot: function-body reassignment violation"
  source = <<~RUGO
    def f()
      x : int = 10
      x = "oops"
      return x
    end
    puts(f())
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot assign string value to")
end

rats "var annot: independent scopes in different functions"
  source = <<~RUGO
    def a()
      x : int = 1
      return x
    end
    def b()
      x : string = "hi"
      return x
    end
    puts(a())
    puts(b())
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
end

rats "var annot: numeric promotion not permitted at assignment site"
  source = <<~RUGO
    x : float = 1.0
    x = 42
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot assign int value to")
end

# =====================================================================
# Section: Tier 3 flow-sensitive checks (callsite + return)
# =====================================================================

rats "tier3: callsite flow flags identifier arg with concrete string type"
  source = <<~RUGO
    def f(x : int)
      return x
    end
    y = "hello"
    f(y)
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot pass string value as argument 1 to 'f'")
end

rats "tier3: callsite flow allows arg narrowed back to compatible type"
  source = <<~RUGO
    def f(x : int)
      return x + 1
    end
    y = "h"
    y = 42
    puts(f(y))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "43")
end

rats "tier3: callsite flow flags arg from if/else union"
  source = <<~RUGO
    def f(x : int)
      return x
    end
    if true
      y = 1
    else
      y = "h"
    end
    f(y)
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot pass")
end

rats "tier3: callsite flow passes dynamic argument silently"
  source = <<~RUGO
    def f(x : int)
      return x
    end
    h = {1 => 100}
    x = h[1]
    puts(f(x))
  RUGO
  result = eval.run(source)
  # Dynamic types (here from hash indexing) cannot be proven incompatible
  # at compile time, so the call must compile. Runtime coercion handles
  # the actual conversion.
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "100")
end

rats "tier3: return flow flags ident return with concrete mismatch"
  source = <<~RUGO
    def f() : int
      x = "hello"
      return x
    end
    f()
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot return string value from function declared returning int")
end

rats "tier3: return flow allows ident return narrowed back to compat"
  source = <<~RUGO
    def f() : int
      x = "h"
      x = 42
      return x
    end
    puts(f())
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "42")
end

rats "tier3: implicit return flow flags ident with concrete mismatch"
  source = <<~RUGO
    def f() : int
      x = "hello"
      x
    end
    f()
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot implicitly return string value")
end

rats "tier3: return flow flags ident from union via if-no-else"
  source = <<~RUGO
    def f() : int
      x = 1
      if true
        x = "h"
      end
      return x
    end
    f()
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot return")
end

rats "tier3: combined callsite + return flow with narrowed ident"
  source = <<~RUGO
    def f(x : int) : int
      return x * 2
    end
    y = "h"
    y = 21
    puts(f(y))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "42")
end

rats "tier3: after for-loop maybe-not-executed, ident arg is union and flagged"
  source = <<~RUGO
    def f(x : int)
      return x
    end
    y = 1
    for item in [1, 2, 3]
      y = "h"
    end
    f(y)
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot pass")
end

rats "tier3: after while-loop maybe-not-executed, ident arg is union and flagged"
  source = <<~RUGO
    def f(x : int)
      return x
    end
    y = 1
    while false
      y = "h"
    end
    f(y)
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot pass")
end

rats "tier3: after case-stmt no-else, ident arg is union and flagged"
  source = <<~RUGO
    def f(x : int)
      return x
    end
    s = "a"
    y = 1
    case s
    of "a"
      y = "h"
    end
    f(y)
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  test.assert_contains(result["output"], "cannot pass")
end

# =====================================================================
# Section: Tier 4 fn lambda call-site checks
# =====================================================================
# When a variable is assigned an annotated `fn(...)` lambda and later
# called by name, the compiler validates the arguments against the
# lambda's parameter annotations the same way it does for `def`. The
# binding is tracked flow-sensitively: aliasing propagates the signature,
# reassignment to a different annotated lambda updates it, reassignment
# to a non-fn value clears it, and merge ambiguity drops it silently
# (matching the existing "unresolved is silent" gradual-typing rule).

rats "tier4: lambda direct binding rejects literal type mismatch"
  source = <<~RUGO
    square = fn(n : int) : int
      return n * n
    end
    puts(square("oops"))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass string literal as argument 1 to 'square'")
  test.assert_contains(combined, "parameter 'n' declared as int")
end

rats "tier4: lambda direct binding accepts matching literal"
  source = <<~RUGO
    square = fn(n : int) : int
      return n * n
    end
    puts(square(7))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "49")
end

rats "tier4: lambda binding flagged for second-arg mismatch"
  source = <<~RUGO
    add = fn(a : int, b : int) : int
      return a + b
    end
    puts(add(1, "oops"))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass string literal as argument 2 to 'add'")
  test.assert_contains(combined, "parameter 'b' declared as int")
end

rats "tier4: aliasing propagates the lambda signature"
  source = <<~RUGO
    square = fn(n : int) : int
      return n * n
    end
    g = square
    puts(g("oops"))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass string literal as argument 1 to 'g'")
  test.assert_contains(combined, "parameter 'n' declared as int")
end

rats "tier4: aliased lambda accepts matching literal"
  source = <<~RUGO
    square = fn(n : int) : int
      return n * n
    end
    g = square
    puts(g(6))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "36")
end

rats "tier4: reassignment to a different annotated lambda uses new sig"
  source = <<~RUGO
    f = fn(n : int) : int
      return n
    end
    f = fn(arr : array) : array
      return arr
    end
    puts(f(42))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass int literal as argument 1 to 'f'")
  test.assert_contains(combined, "parameter 'arr' declared as array")
end

rats "tier4: reassignment to non-fn value clears signature (silent)"
  source = <<~RUGO
    f = fn(n : int) : int
      return n
    end
    f = "not a fn anymore"
    puts(len(f))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "16")
end

rats "tier4: variable arg flow-sensitive narrowing through reassignment"
  source = <<~RUGO
    square = fn(n : int) : int
      return n * n
    end
    y = "h"
    y = 5
    puts(square(y))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "25")
end

rats "tier4: variable arg with concrete wrong type flagged"
  source = <<~RUGO
    square = fn(n : int) : int
      return n * n
    end
    y = "hello"
    square(y)
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass string value as argument 1 to 'square'")
end

rats "tier4: branch divergence drops signature (silent at call)"
  source = <<~RUGO
    if true
      f = fn(n : int) : int
        return n
      end
    else
      f = fn(s : string) : string
        return s
      end
    end
    # f's signature is ambiguous after the merge; the call must be
    # silent (no compile error) and fall back to dynamic dispatch.
    puts(f(42))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "42")
end

rats "tier4: lambda passed as arg to higher-order func is silent"
  source = <<~RUGO
    def apply(f, x)
      return f(x)
    end
    inc = fn(n : int) : int
      return n + 1
    end
    # apply's parameter has no annotation, so passing inc here cannot
    # be checked. Calls THROUGH apply are unchecked.
    puts(apply(inc, 41))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "42")
end

rats "tier4: lambda inside an array is silent at call site"
  source = <<~RUGO
    arr = [fn(n : int) : int
      return n + 1
    end]
    # arr[0]("oops") is an indexed call; the callee is not a bare
    # IdentExpr so the Tier 4 check does not fire. Runtime handles it.
    puts(arr[0](41))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "42")
end

rats "tier4: lambda inside function body — local scope check"
  source = <<~RUGO
    def outer()
      g = fn(n : int) : int
        return n * 2
      end
      return g("oops")
    end
    outer()
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass string literal as argument 1 to 'g'")
end

rats "tier4: lambda with no annotated params — no check fires"
  source = <<~RUGO
    f = fn(n)
      return n
    end
    puts(f("anything"))
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_eq(result["output"], "anything")
end

rats "tier4: mixed annotated/unannotated lambda params — only annotated checked"
  source = <<~RUGO
    f = fn(a, b : int)
      return b
    end
    puts(f("anything", "oops"))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass string literal as argument 2 to 'f'")
  test.assert_contains(combined, "parameter 'b' declared as int")
end

rats "tier4: lambda with return-only annotation does NOT trigger arg checks"
  source = <<~RUGO
    f = fn(n) : int
      return 0
    end
    puts(f("anything"))
  RUGO
  result = eval.run(source)
  # n has no annotation, so passing a string is silent at the call site.
  test.assert_eq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_eq(str.contains(combined, "cannot pass"), false)
end

rats "tier4: --no-infer disables lambda call-site checks"
  source = <<~RUGO
    square = fn(n : int) : int
      return n
    end
    puts(square("oops"))
  RUGO
  # Write the snippet to a tempfile and run rugo with --no-infer
  # to verify the lambda check is gated on inference like the def
  # check is.
  dir = test.tmpdir()
  path = dir + "/snippet.rugo"
  test.write_file(path, source)
  result = test.run("rugo run --no-infer " + path)
  combined = result["output"] + result["output"]
  test.assert_eq(str.contains(combined, "cannot pass string literal"), false)
end

rats "tier4: permissive rule — int passed where string-annotated lambda param"
  source = <<~RUGO
    f = fn(name : string)
      puts("hi " + name)
    end
    x = 42
    f(x)
  RUGO
  result = eval.run(source)
  # Per compatibility rule, `string` annotations accept anything.
  test.assert_eq(result["status"], 0)
  test.assert_contains(result["output"], "hi 42")
end

rats "tier4: permissive rule — int passed where float-annotated lambda param"
  source = <<~RUGO
    f = fn(x : float) : float
      return x + 1.0
    end
    puts(f(2))
  RUGO
  result = eval.run(source)
  # Numeric family is mutually compatible.
  test.assert_eq(result["status"], 0)
  test.assert_contains(result["output"], "3")
end

rats "tier4: lambda call-site check skips method/dot calls"
  source = <<~RUGO
    f = fn(n : int) : int
      return n
    end
    h = {"go" => f}
    # h["go"](...) is a method/index call, not a bare ident — skipped.
    puts(h["go"]("oops"))
  RUGO
  result = eval.run(source)
  # Should compile (no compile error from Tier 4); runtime may fail.
  combined = result["output"] + result["output"]
  test.assert_eq(str.contains(combined, "cannot pass string literal"), false)
end

rats "tier4: lambda param shadows outer fn binding (no false positive)"
  # Regression: an inner fn lambda whose own param shadows an outer
  # variable that happens to hold an annotated lambda. The inner call
  # MUST resolve to the param, not fall through to the outer binding.
  source = <<~RUGO
    f = fn(n : int) : int
      return n
    end
    g = fn(f)
      return f("ok")
    end
    puts(g(42))
  RUGO
  result = eval.run(source)
  # The compile-time Tier 4 check must NOT fire on `f("ok")` inside g.
  combined = result["output"] + result["output"]
  test.assert_eq(str.contains(combined, "cannot pass string literal"), false)
end

rats "tier4: function-body local shadows top-level fn binding"
  # Inside a def, a local rebinding to a non-fn value must not be
  # confused with the outer fn variable. (def bodies use a fresh
  # inference scope so this is naturally silent, but keep a guard.)
  source = <<~RUGO
    f = fn(n : int) : int
      return n
    end
    def use_local()
      f = "not a fn"
      return f
    end
    puts(use_local())
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
  test.assert_contains(result["output"], "not a fn")
end

rats "tier4: inner if/else cannot leak fn binding to outer scope"
  # Both arms drop the binding (or never establish one); after the if,
  # the outer call must resolve against the original fn binding.
  source = <<~RUGO
    f = fn(n : int) : int
      return n
    end
    if 1 == 1
      f = "x"
    else
      f = 99
    end
    # Both arms cleared the binding, so calling f after the if is
    # silent at the Tier 4 layer (runtime will fail).
    nil
  RUGO
  result = eval.run(source)
  test.assert_eq(result["status"], 0)
end

rats "tier4: aliasing chain of three propagates signature"
  source = <<~RUGO
    f = fn(n : int) : int
      return n
    end
    g = f
    h = g
    puts(h("oops"))
  RUGO
  result = eval.run(source)
  test.assert_neq(result["status"], 0)
  combined = result["output"] + result["output"]
  test.assert_contains(combined, "cannot pass string literal as argument 1 to 'h'")
  test.assert_contains(combined, "parameter 'n' declared as int")
end

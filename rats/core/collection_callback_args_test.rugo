# RATS: kata zg09 — missing collection callbacks get actionable errors.
use "test"
use "eval"

# Only the runtime operation belongs in action. Assertions and skips stay outside.
def assert_callback_error(expected, action)
  raised = false
  message = ""
  try action() or err
    raised = true
    message = err
  end
  if !raised
    test.fail "expected error: #{expected}; call succeeded"
  end
  test.assert_eq message, expected
end

def missing_callback_cases(items)
  return [
    {method: "map", action: fn() items.map() end},
    {method: "filter", action: fn() items.filter() end},
    {method: "reject", action: fn() items.reject() end},
    {method: "each", action: fn() items.each() end},
    {method: "find", action: fn() items.find() end},
    {method: "any", action: fn() items.any() end},
    {method: "all", action: fn() items.all() end},
    {method: "count", action: fn() items.count() end}
  ]
end

def missing_array_callback_cases(items)
  cases = missing_callback_cases(items)
  append cases, {method: "sort_by", action: fn() items.sort_by() end}
  append cases, {method: "flat_map", action: fn() items.flat_map() end}
  return cases
end

rats "array callback methods explain missing arguments"
  for row in missing_array_callback_cases([1, 2, 3])
    assert_callback_error(".#{row.method}() requires a function argument", row.action)
  end
end

rats "empty arrays still require callbacks"
  for row in missing_array_callback_cases([])
    assert_callback_error(".#{row.method}() requires a function argument", row.action)
  end
end

rats "hash callback methods explain missing arguments"
  for row in missing_callback_cases({a: 1})
    assert_callback_error(".#{row.method}() requires a function argument", row.action)
  end
end

rats "empty hashes still require callbacks"
  for row in missing_callback_cases({})
    assert_callback_error(".#{row.method}() requires a function argument", row.action)
  end
end

# Keep the original top-level source and line-2 contract for every matrix entry.
def assert_missing_callback_location(collection, method)
  source = <<~RUGO
    items = #{collection}
    items.#{method}()
  RUGO
  result = eval.run(source)
  if result.status == 0
    test.fail "#{collection}.#{method}() unexpectedly succeeded: #{result.output}"
  end
  test.assert_contains result.output, ".#{method}() requires a function argument"
  test.assert_contains result.output, "eval.rugo:2"
end

rats "array missing callbacks identify their call site"
  for method in ["map", "filter", "reject", "each", "find", "any", "all", "count", "sort_by", "flat_map"]
    assert_missing_callback_location("[1, 2, 3]", method)
  end
end

rats "empty array missing callbacks identify their call site"
  for method in ["map", "filter", "reject", "each", "find", "any", "all", "count", "sort_by", "flat_map"]
    assert_missing_callback_location("[]", method)
  end
end

rats "hash missing callbacks identify their call site"
  for method in ["map", "filter", "reject", "each", "find", "any", "all", "count"]
    assert_missing_callback_location("{a: 1}", method)
  end
end

rats "empty hash missing callbacks identify their call site"
  for method in ["map", "filter", "reject", "each", "find", "any", "all", "count"]
    assert_missing_callback_location("{}", method)
  end
end

rats "missing callback errors are recoverable with try or"
  items = [1, 2, 3]
  message = try items.filter() or err
    (err)
  end
  test.assert_eq(message, ".filter() requires a function argument")
end

rats "invalid callbacks retain their type information"
  for collection in ["[1]", "[]", "{a: 1}", "{}"]
    for row in [{argument: "nil", type_name: "nil"}, {argument: "42", type_name: "Integer"}]
      source = <<~RUGO
        items = #{collection}
        items.map(#{row.argument})
      RUGO
      result = eval.run(source)
      test.assert_neq result.status, 0
      test.assert_contains result.output, ".map() requires a function argument, got #{row.type_name}"
    end
  end
end

rats "reduce retains its two argument validation"
  for collection in ["[1]", "{a: 1}"]
    for arguments in ["", "0"]
      source = <<~RUGO
        items = #{collection}
        items.reduce(#{arguments})
      RUGO
      result = eval.run(source)
      test.assert_neq result.status, 0
      test.assert_contains result.output, ".reduce() requires an initial value and a function"
    end
    source = <<~RUGO
      items = #{collection}
      items.reduce(0, nil)
    RUGO
    result = eval.run(source)
    test.assert_neq result.status, 0
    test.assert_contains result.output, ".reduce() requires a function argument, got nil"
  end
end

rats "custom hash callbacks are not mistaken for array methods"
  object = {sort_by: fn() "custom sort" end, flat_map: fn() "custom map" end}
  test.assert_eq(object.sort_by(), "custom sort")
  test.assert_eq(object.flat_map(), "custom map")
end
